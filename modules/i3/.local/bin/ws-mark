#!/usr/bin/env bash
# Put the current window on a named workspace: move it to the i3 workspace
# "ws:<name>" so the switcher ($mod+o) finds it, e.g. a browser window to
# keep around or a terminal you ssh from.
#
# Usage: ws-mark [name [title]]   (asks for what is missing)
#        ws-mark --rofi           (any focused window, no terminal needed)
#
# The old --ws flag is accepted and ignored; "dev:<name>" workspaces are no
# longer made by hand (only bash_in_dev_container.sh still makes them).
# Several windows may share one name: moving another one to a workspace that
# is already open just adds it there.
#
# --rofi (the "Mark this window as named workspace" launcher entry) lists the
# open named workspaces, then the registry ones that are not open; typing
# any other valid name creates a new one (and asks for an optional title).
# The focused window moves to ws:<name>; errors go to notify-send. Picking
# an existing name keeps its registry line.
#
# Also records the name in the registry named_workspaces.tsv next to the
# devbox registry (columns: see ws-edit), with a fifth column "manual" and
# path "-" unless, when it asks for name and title in a terminal, you let it
# record the current directory. Nothing is written into the current
# directory.
set -euo pipefail

rofi_mode=0; kind="named workspace"; prefix="ws:"; regname=named_workspaces.tsv
while [[ "${1:-}" == --rofi || "${1:-}" == --ws ]]; do
  [[ "$1" == --rofi ]] && rofi_mode=1
  shift
done

fail() {
  echo "ws-mark: $1" >&2
  [[ $rofi_mode == 1 ]] && { notify-send "Mark window" "$1" 2>/dev/null || true; }
  exit 1
}

registry="${XDG_STATE_HOME:-$HOME/.local/state}/devbox/$regname"
for old in "$(dirname "$registry")/registry.tsv" "$registry.old"; do
  if [[ -e "$old" ]]; then
    echo "ws-mark: warning: old registry $old still exists; it is no longer used, delete it." >&2
    [[ $rofi_mode == 1 ]] && { notify-send "Mark window" "Old registry $old is no longer used, delete it." 2>/dev/null || true; }
  fi
done

have_i3() { command -v i3-msg >/dev/null 2>&1 && i3-msg -t get_version >/dev/null 2>&1; }
have_i3 || fail "i3 is not reachable (i3-msg -t get_version failed)."
[[ $rofi_mode == 1 || ( -t 0 && -t 1 ) ]] || fail "needs a terminal."

valid='^[A-Za-z0-9_-]{1,16}$'
name="${1:-}"; title="${2:-}"
known=0; dir=-
if [[ $rofi_mode == 1 ]]; then
  command -v rofi >/dev/null 2>&1 || fail "rofi not found."
  workspaces=$(i3-msg -t get_workspaces)
  running=$(jq -r --arg p "$prefix" '.[].name | select(startswith($p)) | .[($p | length):]' <<< "$workspaces" | sort)
  registered=$(awk -F'\t|  +' '!/^[ \t]*(#|$)/ && !seen[$1]++ {print $1}' "$registry" 2>/dev/null || true)
  names=$({ printf '%s\n' "$running"; printf '%s\n' "$registered"; } | awk 'NF && !seen[$0]++')
  # Open ones first, then the registry ones that are not open.
  choice=$(rofi -dmenu -i -p "$kind (new name: type it)" <<< "$names") || exit 0
  name="${choice//[$'\t\r\n']/}"
  [[ "$name" =~ $valid ]] || fail "Use 1-16 letters, digits, - or _ (got \"$name\")."
  if grep -qxF -- "$name" <<< "$names"; then
    known=1
  else
    title=$(rofi -dmenu -p "title for $name (optional)" < /dev/null) || exit 0
  fi
elif ! [[ "$name" =~ $valid ]]; then
  [[ -z "$name" ]] || echo "ws-mark: use 1-16 letters, digits, - or _." >&2
  while :; do
    read -rp "Short name (i3 workspace ${prefix}<name>): " name
    [[ "$name" =~ $valid ]] && break
    echo "  Use 1-16 letters, digits, - or _." >&2
  done
  read -rp "Longer title (optional): " title
  read -rp "Add current directory ($PWD)? [y/N] " add_dir
  [[ "$add_dir" =~ ^[Yy] ]] && dir="${PWD//[$'\t\r\n']/ }"
fi
title="${title//$'\t'/ }"; : "${title:=$name}"
ws="$prefix$name"

if [[ $known == 0 ]]; then
  mkdir -p "$(dirname "$registry")"
  tmp=$(mktemp "$registry.XXXXXX")
  edit="$(dirname "$0")/ws-edit"
  # Aligned format with a comment header (see ws-edit); a file in the old
  # format is set aside once.
  if [[ -s "$registry" ]] && ! grep -qm1 '^#' "$registry"; then mv "$registry" "$registry.old"; fi
  title="${title//  / }"
  { awk -F'\t|  +' -v n="$name" '!/^[ \t]*(#|$)/ && $1 != n' "$registry" 2>/dev/null || true
    printf '%s\t%s\t%s\t%s\tmanual\n' "$name" "$dir" "$title" "$(date -Is)"; } |
    bash "$edit" --normalize > "$tmp" || { rm -f "$tmp"; fail "could not write $registry."; }
  mv "$tmp" "$registry"
fi

i3-msg "move container to workspace \"$ws\"; workspace \"$ws\"" >/dev/null
echo "Window is now $kind \"$name\" (workspace $ws)."
